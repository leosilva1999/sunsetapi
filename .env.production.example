# Copy to .env.production (gitignored) and fill in. Double underscore = nested config key.
ConnectionStrings__DefaultConnection=Host=<host>;Database=sunset;Username=<user>;Password=<password>;SSL Mode=Require
# Base64 of at least 32 random bytes (HS256 needs > 256 bits): openssl rand -base64 48
Jwt__Secret=
GoogleAuth__ClientId=
# Proxy hops in front of the API whose X-Forwarded-For entries are trusted. Render measured 2026-10-30:
# Cloudflare -> Render load balancer -> internal hop = 3 (check GET /health/client-ip: clientIp must be the visitor's IP).
ForwardedHeaders__ForwardLimit=3
# Secret the site's server sends as the X-Service-Key header to get its own rate-limit bucket (>= 32 chars):
# openssl rand -base64 32     (the same value goes in the site's SERVER environment, never in browser code)
Service__ApiKey=
Cors__AllowedOrigins__0=https://<frontend-domain>
Frontend__BaseUrl=https://<frontend-domain>
Storage__BucketName=
Storage__Region=
Storage__ServiceUrl=
Storage__ForcePathStyle=false
# Real S3: bucket in the host, no trailing slash, e.g. https://<bucket>.s3.<region>.amazonaws.com
# Leave Storage__ServiceUrl empty (it is only for LocalStack).
Storage__PublicBaseUrl=
Storage__AccessKey=
Storage__SecretKey=
# Email provider: Smtp (default) or HostingerApi (HTTPS - use this on Render's free tier, which blocks SMTP ports)
Email__Provider=Smtp
Hostinger__Mail__ApiKey=
Hostinger__Mail__MailboxResourceId=
Hostinger__Mail__DisplayName=Sunsetsss
Smtp__Host=
# 465 = implicit TLS (e.g. Hostinger smtp.hostinger.com), 587 = STARTTLS; both use the credentials below
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=Sunsetsss
Smtp__UseStartTls=true
