# Copy to .env.production (gitignored) and fill in. Double underscore = nested config key.
ConnectionStrings__DefaultConnection=Host=<host>;Database=sunset;Username=<user>;Password=<password>;SSL Mode=Require
# Base64 of at least 32 random bytes (HS256 needs > 256 bits): openssl rand -base64 48
Jwt__Secret=
GoogleAuth__ClientId=
Cors__AllowedOrigins__0=https://<frontend-domain>
Frontend__BaseUrl=https://<frontend-domain>
Storage__BucketName=
Storage__Region=
Storage__ServiceUrl=
Storage__ForcePathStyle=false
# Real S3: bucket in the host, no trailing slash, e.g. https://<bucket>.s3.<region>.amazonaws.com
# Leave Storage__ServiceUrl empty (it is only for LocalStack).
Storage__PublicBaseUrl=
Storage__AccessKey=
Storage__SecretKey=
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=Sunsetsss
Smtp__UseStartTls=true
