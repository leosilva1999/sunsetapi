{
  "_comment": "Copy to appsettings.Development.local.json (gitignored) and fill in your current LAN IP. Needed so a phone on Expo Go can reach LocalStack's presigned upload URLs and the public photo/avatar URLs - 'localhost' in appsettings.Development.json resolves to the phone itself, not your PC. Re-run `ipconfig` and update this file whenever your LAN IP changes, same as EXPO_PUBLIC_API_BASE_URL in the mobile app's .env.",
  "Storage": {
    "ServiceUrl": "http://YOUR_LAN_IP:4566",
    "PublicBaseUrl": "http://YOUR_LAN_IP:4566/sunset-photos"
  }
}
