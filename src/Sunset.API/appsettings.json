{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "SunsetApi",
    "Audience": "SunsetApiClients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "GoogleAuth": {
    "ClientId": ""
  },
  "Storage": {
    "BucketName": "",
    "Region": "",
    "ServiceUrl": "",
    "ForcePathStyle": false,
    "PublicBaseUrl": "",
    "AccessKey": "",
    "SecretKey": ""
  },
  "Email": {
    "Provider": "Smtp"
  },
  "Hostinger": {
    "Mail": {
      "BaseUrl": "https://api.mail.hostinger.com/",
      "ApiKey": "",
      "MailboxResourceId": "",
      "DisplayName": "Sunsetsss"
    }
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "",
    "UseStartTls": true
  },
  "Frontend": {
    "BaseUrl": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {RequestId} {UserId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sunset-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 20971520,
          "retainedFileCountLimit": 10,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {RequestId} {UserId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
